 "Balance Notes": {
  "ECONOMY BALANCE - Design Rules and Anti-Exploit Systems": [
   {
    "Rule": "Shield System",
    "Rationale": "After being raided: 12-hour shield. Cannot be raided but also cannot attack others. Attacking manually breaks shield early. Prevents shield-farming."
   },
   {
    "Rule": "Raid Matchmaking",
    "Rationale": "Players matched within 20% of total stored resource value. Trophy system provides secondary layer. Prevents rich players farming beginners."
   },
   {
    "Rule": "Loot Cap and Protected Storage",
    "Rationale": "Loot per raid = min(steal% x lootable amount, Loot Cap for defender CC). Each storage building protects 10% of its capacity (never lootable). Replaces the old '10% of reserves' cap, which contradicted the 20/25/15% steal rates."
   },
   {
    "Rule": "Oil Debt Prevention",
    "Rationale": "If player has less than 500 Oil they cannot be raided for Oil. Prevents players being permanently locked out of raiding."
   },
   {
    "Rule": "New Player Peace Shield",
    "Rationale": "3-day peace shield on new account. Passive income only. Lets players build before PvP exposure."
   },
   {
    "Rule": "Diminishing Returns",
    "Rationale": "Raiding same player twice in 24 hrs: steal drops 50%. Third raid: drops to 10%. Prevents targeted griefing."
   },
   {
    "Rule": "Resource Overflow Spoilage",
    "Rationale": "Collectors stop at 150% of local storage capacity. Encourages daily logins. Prevents total AFK farming."
   },
   {
    "Rule": "Black Market Gold Sink",
    "Rationale": "Excess Gold can buy small Oil or Steel packages at premium rate. Prevents Gold hoarding and helps resource-poor players recover."
   },
   {
    "Rule": "War Spoils Streak Bonus",
    "Rationale": "5 wins in a row grants 25% bonus steal on 6th raid. Rewards active attackers. Streak resets on any defeat or timeout."
   },
   {
    "Rule": "Collector HP Design",
    "Rationale": "Destroying a collector in a raid disables it for 30 min repair time. Intentional - economic warfare is a valid strategy alongside direct destruction."
   }
  ]
 }
}