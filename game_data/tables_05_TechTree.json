{
 "System Overview": {
  "Each nation has its own independent tech tree. Tiers are gated by time, resources, and trophies.": [
   {
    "TOPIC": "Nation Trees",
    "RULE": "5 nations each have a separate tech tree. Players unlock each nation independently. Progress is never lost when switching."
   },
   {
    "TOPIC": "Starting Nation",
    "RULE": "Player picks one nation at account creation. That nation starts with Tier I free. All other nations must be unlocked from Tier I upward."
   },
   {
    "TOPIC": "Tier Gates",
    "RULE": "Each tier requires all four: Command Center and Research Lab at required level, Gold and Steel cost paid, trophy count reached, and unlock time waited."
   },
   {
    "TOPIC": "Individual Vehicles",
    "RULE": "Within an unlocked tier, vehicles are unlocked one at a time using Research Points. Players choose which vehicles to research first within the tier."
   },
   {
    "TOPIC": "Research Points",
    "RULE": "RP is a soft currency earned through gameplay only and is never sold. Each vehicle costs a set RP amount. RP earn rate scales with Command Center level (see RP Earn Rates tab)."
   },
   {
    "TOPIC": "Tier Prerequisite",
    "RULE": "Cannot unlock Tier III without completing Tier II. All vehicles in a tier must be researched before the next tier opens."
   },
   {
    "TOPIC": "Nation Bonus",
    "RULE": "Each nation grants a passive bonus to all its vehicles. Germany +15% armor. USSR +20% HP. USA +15% air. Britain +10% TD range. Japan +20% speed."
   },
   {
    "TOPIC": "Prestige",
    "RULE": "After maxing all 5 tiers, players can Prestige. Resets the tree but grants permanent +5% stat bonus and unique cosmetic flag."
   },
   {
    "TOPIC": "Multi-Nation",
    "RULE": "Players can run multiple nations simultaneously. A base can field vehicles from any unlocked nation. Encourages long-term investment."
   },
   {
    "TOPIC": "Dark Barracks Gate",
    "RULE": "Tier V needs ALL of: Command Center Lv9, Research Lab Lv5, and a Dark Barracks. Dark Barracks can be built at CC8 but Tier V units cannot be trained until CC9."
   },
   {
    "TOPIC": "Unit names",
    "RULE": "Names on these tabs match the Unit Roster workbook exactly. Roster is the source of truth."
   }
  ]
 },
