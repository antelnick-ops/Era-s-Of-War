{
 "Monetization Overview": {
  "Free-to-play. Premium currency is called War Bonds (WB). Working numbers, all tunable. Yellow cells in other tabs are inputs.": [
   {
    "TOPIC": "Model",
    "RULE": "Free to play with optional purchases. No ads at launch (can be added later as optional rewarded ads)."
   },
   {
    "TOPIC": "Premium currency",
    "RULE": "War Bonds (WB). Bought with real money, also earned slowly in play. Gold, Oil, Steel and RP keep working exactly as designed."
   },
   {
    "TOPIC": "What WB can buy",
    "RULE": "Time (speed-ups), extra Engineer Crews, resource packs (capped), peace shields, cosmetics, convenience slots, Season Pass."
   },
   {
    "TOPIC": "What WB can NOT buy",
    "RULE": "Research Points (RP stay earned-only per the tech tree rule), trophies, units directly, stat boosts, or anything that skips matchmaking."
   },
   {
    "TOPIC": "No random paid boxes",
    "RULE": "Nothing paid is randomized (no loot boxes or gacha). Every purchase shows exactly what you get. This also avoids loot-box laws in several countries."
   },
   {
    "TOPIC": "Anti pay-to-win",
    "RULE": "Money buys speed and looks. Tier gates (trophies, CC level, Research Lab, Dark Barracks) cannot be bought. A free player reaches the same content, just later."
   },
   {
    "TOPIC": "Resource pack caps",
    "RULE": "Bought resources only fill free storage, and each resource can be bought with WB once per 24 hours."
   },
   {
    "TOPIC": "Store rules",
    "RULE": "All purchases go through Apple and Google billing. Subscriptions and passes use store subscriptions. Always include a Restore Purchases button."
   },
   {
    "TOPIC": "Audience",
    "RULE": "Rate for ages 13+ (avoids children's privacy rules for under-13). Optional spend limit in settings."
   },
   {
    "TOPIC": "Where numbers live",
    "RULE": "Top-Up Packs, WB Prices, Loot Caps, Offers, Revenue Model tabs. Same values are exported to game_data/economy.json."
   }
  ]
 },
